# ===========================================================
# Llaves de Supabase. Copia este archivo como ".env" y llénalo.
# El archivo .env NO se sube a GitHub (ya está en .gitignore).
#
# Si dejas estos valores tal cual, la app funciona en MODO LOCAL
# (datos de prueba en memoria). Con llaves reales, usa Supabase.
# Pasos completos en SUPABASE.md.
# ===========================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API → anon / public key
# Es pública a propósito: la seguridad la ponen las reglas RLS de schema.sql.
VITE_SUPABASE_ANON_KEY=tu-llave-publica-anon

# Supabase → Project Settings → API → service_role key (SECRETA)
# Solo la usa "npm run supabase:cargar" en tu computador.
# NUNCA le pongas el prefijo VITE_, nunca la subas a GitHub ni a Vercel.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-secreta-service-role
